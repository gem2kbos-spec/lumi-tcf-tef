# 推荐：DeepSeek。密钥仅保存在本机，不要提交到 Git。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# 可选备用：未配置 DeepSeek 时使用 OpenAI。
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
PORT=3000
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=replace-with-a-long-random-password
